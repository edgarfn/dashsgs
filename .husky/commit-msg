# Conventional Commits (doc 24 §6) — mensagem ruim hoje é arqueologia amanhã.
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9.-]+\))?!?: .{1,100}$'
first_line=$(head -n1 "$1")

if ! echo "$first_line" | grep -Eq "$pattern"; then
  echo "Mensagem fora do padrão Conventional Commits."
  echo "  exemplo: feat(api): adiciona health check de migrações"
  echo "  recebido: $first_line"
  exit 1
fi
