# =============================================================================
# DashSGS — contrato de ambiente de STAGING/PRODUÇÃO (doc 19). Validado por zod no boot da API;
# as variáveis que não começam com uma das que o zod valida (POSTGRES_*, REDIS_PASSWORD,
# APP_DOMAIN/API_DOMAIN/ACME_EMAIL, WALG_*, GRAFANA_*, ALERTMANAGER_*) são lidas direto pelo
# Postgres/Redis/Caddy/backup — ver docker/compose.staging.yml.
#
# Este arquivo é seguro para o Git: todo valor sensível é CHANGE_ME. O real vive em
# /opt/dashsgs/.env.staging na VM (permissão 600, fora do repositório) — nunca commitado, nunca
# em imagem. `envSchema` (apps/api/src/config/env.schema.ts) RECUSA o boot em produção se
# encontrar "CHANGE_ME"/"dev_only" em SESSION_SECRET, CSRF_SECRET, PII_PEPPER ou
# MASTER_KEY_CURRENT — é a rede de segurança contra subir isto sem editar.
#
# Comandos de geração ao lado de cada segredo assumem um shell com `openssl`.
# =============================================================================

# --- App ---------------------------------------------------------------------
NODE_ENV=production
# https:// obrigatório em produção (envSchema recusa http:// aqui).
APP_URL=https://app.exemplo.com.br
API_URL=https://api.exemplo.com.br
PORT=3001
LOG_LEVEL=info
# Preenchido pelo deploy.sh a partir do digest da imagem — não defina aqui.
# APP_VERSION=

# Gere com: openssl rand -base64 48   (mínimo 32 caracteres; o exemplo do openssl tem margem)
SESSION_SECRET=CHANGE_ME
CSRF_SECRET=CHANGE_ME
# Domínio real do app — cookies `__Host-` já fixam o resto (doc 09 §1).
COOKIE_DOMAIN=app.exemplo.com.br

# --- Banco (lido pela aplicação) ---------------------------------------------
# app_rw/app_migrator só existem depois de ./scripts/provision-roles.sh (doc 19 §6) — a senha
# aqui tem que ser a MESMA que você passou àquele script; nada lê de volta, nada confere sozinho.
DATABASE_URL=postgresql://app_rw:CHANGE_ME@postgres:5432/dashsgs?schema=public&sslmode=disable
DATABASE_URL_MIGRATOR=postgresql://app_migrator:CHANGE_ME@postgres:5432/dashsgs?schema=public&sslmode=disable
# sslmode=disable é aceitável AQUI porque a rede `data` do compose de staging é `internal: true`
# — sem rota para a internet (doc 19 §2). Postgres gerenciado fora dessa rede (RDS/Cloud SQL/
# Neon, recomendado assim que houver cliente pagante) exige sslmode=require ou melhor.
REDIS_URL=redis://:CHANGE_ME@redis:6379
# ^ a senha aqui PRECISA ser idêntica a REDIS_PASSWORD, duas linhas abaixo — são o mesmo segredo
# em dois formatos (URL vs argumento de linha de comando do redis-server), sem checagem cruzada.

# --- Criptografia (envelope AES-256-GCM — doc 09 §2) -------------------------
# 32 bytes exatos em base64. Gere com: openssl rand -base64 32
MASTER_KEY_CURRENT=CHANGE_ME
MASTER_KEY_VERSION=1
# MASTER_KEY_PREVIOUS=   # preencher só durante rotação de chave (runbook 22 §5)
# 16+ caracteres, não precisa ser base64 exato como a chave mestra.
PII_PEPPER=CHANGE_ME

# --- E-mail ------------------------------------------------------------------
SMTP_URL=smtp://usuario:CHANGE_ME@smtp.exemplo.com.br:587
MAIL_FROM="DashSGS <nao-responda@exemplo.com.br>"

# --- Observabilidade ---------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
METRICS_ENABLED=true

# --- Integração SG (doc 12) --------------------------------------------------
SG_DEFAULT_MAX_RPS=4
SG_HTTP_TIMEOUT_MS=60000
SG_HEAVY_TIMEOUT_MS=180000
# false é o único valor aceito em produção — o boot recusa qualquer outro (doc 09 §1 / doc 34 Q1).
ALLOW_INSECURE_ERP=false
SG_MOCK=false
SG_VPN_CIDR=10.66.0.0/16

# Q2/Q4/Q5 sem resposta da SG — padrão observado na homologação; cada tenant sobrescreve na tela
# de Conexão ERP (doc 34 §4).
SG_API_PATH_PREFIX=
SG_AUTH_HEADER_MODE=raw
SG_PAGE_SIZE=500
SG_PAGE_SIZE_MIN=50

# --- Sincronização (doc 14) ---------------------------------------------------
SYNC_CONCURRENCY=4
# Só o processo `workers` do compose de staging define isto true (já vem fixo no compose —
# não precisa repetir aqui); mantenha false se este arquivo também for usado por um segundo
# processo de worker, para não duplicar cadência.
SYNC_SCHEDULER_ENABLED=true
WORKER_PORT=3002

# --- Feature flags -------------------------------------------------------------
FEATURE_ERP_WRITE=false
FEATURE_CLIENT_MODULE=false

# --- Frontend (Next.js) --------------------------------------------------------
NEXT_PUBLIC_APP_NAME=DashSGS
INTERNAL_API_URL=http://api:3001

# =============================================================================
# A partir daqui: variáveis que a APLICAÇÃO não lê. Alimentam só os containers do
# docker/compose.staging.yml e docker/compose.observability.yml — mas moram neste arquivo
# porque `--env-file .env.staging` é o único arquivo que os dois compose recebem (doc 19 §3).
# =============================================================================

# --- Postgres (container) -----------------------------------------------------
# Superusuário de BOOTSTRAP do container — não é o app_rw/app_migrator da aplicação. Usado só
# por scripts/provision-roles.sh (doc 19 §6) e por backup/restore. Gere com: openssl rand -hex 24
POSTGRES_USER=dashsgs_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=dashsgs

# --- Redis (container) ---------------------------------------------------------
# hex evita caractere que quebraria a URL ou o parsing deste arquivo (# $ espaço =).
# Gere com: openssl rand -hex 24 — e copie o MESMO valor para dentro de REDIS_URL, acima.
REDIS_PASSWORD=CHANGE_ME

# --- Borda / Caddy (doc 19 §5) --------------------------------------------------
APP_DOMAIN=app.exemplo.com.br
API_DOMAIN=api.exemplo.com.br
ACME_EMAIL=ops@exemplo.com.br

# --- postgres_exporter (doc 18 §2) ----------------------------------------------
# app_monitor só existe depois de provision-roles.sh; mesma senha passada àquele script.
POSTGRES_EXPORTER_DSN=postgresql://app_monitor:CHANGE_ME@postgres:5432/dashsgs?sslmode=disable

# --- Grafana (só escuta em 127.0.0.1; acesso por túnel SSH — doc 19 §7) --------
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# --- Alertmanager (doc 18 §5) ---------------------------------------------------
ALERTMANAGER_SMTP_HOST=smtp.exemplo.com.br:587
ALERTMANAGER_FROM=alertas@exemplo.com.br
ALERTMANAGER_ONCALL_EMAIL=oncall@exemplo.com.br
ALERTMANAGER_PLATAFORMA_EMAIL=plataforma@exemplo.com.br

# --- WAL-G (doc 20 §2) -----------------------------------------------------------
# Bucket em OUTRA região/provedor do que a VM, com object-lock ligado — backup no mesmo lugar
# que o banco não sobrevive ao incidente que o banco não sobrevive.
WALG_S3_PREFIX=s3://dashsgs-backup
WALG_ENDPOINT=https://s3.exemplo.com
WALG_REGION=us-east-1
WALG_FORCE_PATH_STYLE=true
WALG_ACCESS_KEY_ID=CHANGE_ME
WALG_SECRET_ACCESS_KEY=CHANGE_ME
# 32 bytes em hex. Gere com: openssl rand -hex 32 — backup.sh RECUSA rodar sem isto (doc 20 §2):
# backup em claro num storage de terceiro é vazamento com agendamento.
WALG_LIBSODIUM_KEY=CHANGE_ME
