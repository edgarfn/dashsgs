# =============================================================================
# DashSGS — contrato de ambiente (doc 19 §3). Validado por zod no boot (falha rápida).
# Este arquivo é seguro para o Git: contém APENAS valores de desenvolvimento.
# Produção: SOPS/age (*.enc.env) ou secret manager. NUNCA segredo real aqui.
# =============================================================================

# --- App ---------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
PORT=3001
LOG_LEVEL=debug

# Segredos de sessão/CSRF (>=32 bytes). Gere com: openssl rand -base64 48
SESSION_SECRET=dev_only_session_secret_change_me_32bytes_minimum_ok
CSRF_SECRET=dev_only_csrf_secret_change_me_32bytes_minimum_okay
COOKIE_DOMAIN=localhost

# --- Banco / Cache ---------------------------------------------------------
# Se a máquina já tiver Postgres/Redis locais, troque a porta publicada pelo compose
# (e ajuste as URLs abaixo): POSTGRES_PORT=55432 / REDIS_PORT=56379--
# app_rw: papel da aplicação, SEM BYPASSRLS (doc 08 §3)
DATABASE_URL=postgresql://app_rw:dev_only_password@localhost:5432/dashsgs?schema=public
# app_migrator: papel exclusivo de migração (usado só pelo job de migrate)
DATABASE_URL_MIGRATOR=postgresql://app_migrator:dev_only_password@localhost:5432/dashsgs?schema=public
# banco sombra para detecção de drift do Prisma (CI e dev)
SHADOW_DATABASE_URL=postgresql://app_migrator:dev_only_password@localhost:5432/dashsgs_shadow?schema=public
REDIS_URL=redis://localhost:6379

# --- Criptografia (envelope AES-256-GCM — doc 09 §2) -------------------------
# 32 bytes em base64. Gere com: openssl rand -base64 32
MASTER_KEY_CURRENT=ZGV2X29ubHlfbWFzdGVyX2tleV9DSEFOR0VfTUVfMzI=
MASTER_KEY_VERSION=1
# MASTER_KEY_PREVIOUS=   # preencher apenas durante rotação (runbook 22 §5)
PII_PEPPER=dev_only_pii_pepper_change_me_please_32bytes_ok

# --- E-mail ------------------------------------------------------------------
# dev: mailpit (compose) captura tudo em http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM="DashSGS <nao-responda@dashsgs.local>"

# --- Observabilidade ---------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
METRICS_ENABLED=true

# --- Integração SG (doc 12) --------------------------------------------------
SG_DEFAULT_MAX_RPS=4
SG_HTTP_TIMEOUT_MS=60000
SG_HEAVY_TIMEOUT_MS=180000
# http:// para o ERP só é aceito com esta flag (dev/homologação). Em produção o boot recusa.
ALLOW_INSECURE_ERP=true
SG_MOCK=true

# --- Feature flags -----------------------------------------------------------
FEATURE_ERP_WRITE=false
FEATURE_CLIENT_MODULE=false

# --- Frontend (Next.js) ------------------------------------------------------
# Somente variáveis não sensíveis podem ter prefixo NEXT_PUBLIC_
NEXT_PUBLIC_APP_NAME=DashSGS
INTERNAL_API_URL=http://localhost:3001
