    "@types/cookiejar": "^2.1.5",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "cookiejar": "^2.1.4",
    "jest": "^29.7.0",
