    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.2.1",
    "@zxcvbn-ts/core": "^3.0.4",
    "@zxcvbn-ts/language-common": "^3.0.4",
    "@zxcvbn-ts/language-pt-br": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "nestjs-pino": "^4.2.0",
    "nodemailer": "^6.9.16",
    "otpauth": "^9.3.6",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "prisma": "^6.2.1",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
