{
  "rootDir": "..",
  "testEnvironment": "node",
  "moduleFileExtensions": ["js", "json", "ts"],
  "testRegex": "test/integration/.*\\.int-spec\\.ts$",
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "tsconfig": "<rootDir>/test/tsconfig.json" }]
  },
  "testTimeout": 30000,
  "setupFiles": ["<rootDir>/test/setup-integration.ts"]
}
