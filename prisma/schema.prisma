// DashSGS — modelo de dados (doc 05).
// Convenções: PK uuid nas tabelas de app; timestamptz; nomes físicos em snake_case com os
// prefixos app_/erp_/agg_. Políticas de RLS, triggers e grants vivem nas migrações SQL
// (Prisma não os modela) — ver prisma/migrations e doc 08 §3.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  // Migrações usam um papel separado (app_migrator), nunca o papel da aplicação (doc 08 §3).
  directUrl         = env("DATABASE_URL_MIGRATOR")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum TenantStatus {
  active
  suspended

  @@map("tenant_status")
}

enum UserStatus {
  invited
  active
  disabled

  @@map("user_status")
}

/// Papéis do doc 07 (matriz de permissões).
enum MembershipRole {
  owner
  admin
  manager
  analyst
  viewer
  auditor

  @@map("membership_role")
}

enum AuditResult {
  success
  denied
  error

  @@map("audit_result")
}

/// Um contrato DashSGS = uma rede/empresa que usa o ERP SG (doc 08 §1).
model Tenant {
  id               String       @id @default(uuid()) @db.Uuid
  name             String       @db.VarChar(120)
  slug             String       @unique @db.VarChar(60)
  status           TenantStatus @default(active)
  plan             String       @default("beta") @db.VarChar(40)
  timezone         String       @default("America/Sao_Paulo") @db.VarChar(60)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Suspensão preserva os dados e bloqueia acesso/jobs (doc 08 §5, runbook 22 §2).
  suspendedAt      DateTime?    @map("suspended_at") @db.Timestamptz(6)
  suspensionReason String?      @map("suspension_reason") @db.VarChar(200)
  /// Exclusão lógica; a purga física roda no offboarding (doc 08 §5).
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz(6)

  memberships   Membership[]
  sessions      Session[]
  invites       Invite[]
  filiais       ErpFilial[]
  erpConnection ErpConnection?

  @@index([status])
  @@map("app_tenants")
}

/// Filiais do ERP do tenant (doc 05 §3).
///
/// Primeira tabela do espelho `erp_`: entra aqui porque `filiais_allowed` (doc 07 §4.2) precisa
/// de filiais reais para ser exercido fim-a-fim. A sincronização com a API SG é da Fase 6
/// (E5-02); até lá o seed popula filiais sintéticas.
///
/// Chave natural composta `(tenant_id, erp_id)`: o id do ERP é sequencial **por instalação**,
/// nunca global — dois tenants têm filial 1 (doc 08 §1).
model ErpFilial {
  tenantId       String   @map("tenant_id") @db.Uuid
  erpId          Int      @map("erp_id")
  razaoSocial    String   @map("razao_social") @db.VarChar(160)
  nomeFantasia   String?  @map("nome_fantasia") @db.VarChar(160)
  cnpj           String?  @db.VarChar(14)
  municipioErpId Int?     @map("municipio_erp_id")
  uf             String?  @db.Char(2)
  ativa          Boolean  @default(true)
  syncedAt       DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)

  /// FK contra `app_tenants` (tabela de app) — o espelho não declara FKs contra ids do ERP,
  /// que podem chegar fora de ordem (doc 05 §4).
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, erpId])
  @@index([tenantId, syncedAt])
  @@map("erp_filiais")
}

/// Identidade global: um usuário pode pertencer a vários tenants (doc 08 §1).
model User {
  id                   String     @id @default(uuid()) @db.Uuid
  /// Sempre normalizado em minúsculas pela aplicação.
  email                String     @unique @db.VarChar(255)
  name                 String     @db.VarChar(120)
  /// Argon2id (doc 06). Nulo enquanto o convite não for aceito.
  passwordHash         String?    @map("password_hash") @db.VarChar(255)
  status               UserStatus @default(invited)
  /// TOTP cifrado com envelope AES-256-GCM (doc 09 §2) — nunca em claro.
  totpSecretCiphertext Bytes?     @map("totp_secret_ciphertext")
  totpKeyVersion       Int?       @map("totp_key_version")
  totpEnabled          Boolean    @default(false) @map("totp_enabled")
  /// Operação da plataforma (equipe DashSGS). Papel global, fora de membership, com MFA
  /// obrigatório; NÃO dá acesso a dados de negócio dos tenants — isso é break-glass (doc 07 §2).
  platformAdmin        Boolean    @default(false) @map("platform_admin")
  failedAttempts       Int        @default(0) @map("failed_attempts")
  lockedUntil          DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastLoginAt          DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?  @map("deleted_at") @db.Timestamptz(6)

  memberships    Membership[]
  sessions       Session[]
  passwordResets PasswordReset[]
  recoveryCodes  TotpRecoveryCode[]
  invitesCreated Invite[]           @relation("InvitesCreated")

  @@map("app_users")
}

/// Códigos de recuperação do TOTP (doc 06 §MFA): 10 por usuário, uso único, hash no banco.
model TotpRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// sha256(pepper || código) — o código tem entropia alta, não precisa de KDF lento.
  codeHash  String    @map("code_hash") @db.VarChar(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([userId])
  @@map("app_totp_recovery_codes")
}

/// Convite para entrar num tenant (doc 06 §Contas e convites): não existe auto-registro público.
model Invite {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  email          String         @db.VarChar(255)
  role           MembershipRole
  filiaisAllowed Int[]          @default([]) @map("filiais_allowed")
  /// sha256 do token enviado por e-mail; o token em si nunca é persistido.
  tokenHash      String         @unique @map("token_hash") @db.VarChar(64)
  invitedById    String?        @map("invited_by") @db.Uuid
  expiresAt      DateTime       @map("expires_at") @db.Timestamptz(6)
  acceptedAt     DateTime?      @map("accepted_at") @db.Timestamptz(6)
  revokedAt      DateTime?      @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User?  @relation("InvitesCreated", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([tenantId, email])
  @@index([expiresAt])
  @@map("app_invites")
}

/// Vínculo usuário↔tenant com papel e recorte de filiais (doc 07 / doc 08 §1).
model Membership {
  id       String         @id @default(uuid()) @db.Uuid
  userId   String         @map("user_id") @db.Uuid
  tenantId String         @map("tenant_id") @db.Uuid
  role     MembershipRole

  /// Allowlist de filiais do ERP. Array VAZIO = todas as filiais do tenant.
  /// (o doc 05 fala em NULL; o Prisma não modela array anulável, e vazio tem a mesma
  /// semântica sem admitir dois "sem restrição" diferentes no banco)
  filiaisAllowed Int[] @default([]) @map("filiais_allowed")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("app_memberships")
}

/// Sessão server-side (ADR-004): o navegador só carrega o cookie; nada de JWT no cliente.
model Session {
  /// Hash do token de sessão (o token em si nunca é persistido).
  id            String    @id @db.VarChar(64)
  userId        String    @map("user_id") @db.Uuid
  /// Tenant ativo da sessão; NULL enquanto o usuário não escolheu.
  tenantId      String?   @map("tenant_id") @db.Uuid
  ip            String?   @db.Inet
  userAgent     String?   @map("user_agent") @db.VarChar(255)
  mfaPassed     Boolean   @default(false) @map("mfa_passed")
  /// Momento da última verificação de MFA — ações sensíveis exigem ≤15 min (doc 07 §4.3).
  mfaVerifiedAt DateTime? @map("mfa_verified_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("app_sessions")
}

/// Token de recuperação de senha: uso único, expira, invalida sessões ao ser usado (doc 06).
model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([userId])
  @@map("app_password_resets")
}

/// Trilha de auditoria append-only com encadeamento de hash (doc 05 §6 / E6-01).
/// UPDATE e DELETE são revogados e bloqueados por trigger na migração.
model AuditLog {
  id           BigInt      @id @default(autoincrement())
  tenantId     String?     @map("tenant_id") @db.Uuid
  userId       String?     @map("user_id") @db.Uuid
  sessionId    String?     @map("session_id") @db.VarChar(64)
  action       String      @db.VarChar(80)
  resourceType String      @map("resource_type") @db.VarChar(60)
  resourceId   String?     @map("resource_id") @db.VarChar(120)
  result       AuditResult
  ip           String?     @db.Inet
  userAgent    String?     @map("user_agent") @db.VarChar(255)
  /// Diffs relevantes — NUNCA senha, token ou PII bruta (doc 18 §1).
  changes      Json?       @db.JsonB
  prevHash     Bytes?      @map("prev_hash")
  entryHash    Bytes?      @map("entry_hash")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@map("app_audit_log")
}

/// Modo de transporte até o ERP do tenant (doc 12 §1). HTTP público é recusado pelo produto.
enum ErpTlsMode {
  https
  vpn

  @@map("erp_tls_mode")
}

/// Estado operacional da conexão com o ERP (doc 05 §1).
enum ErpConnectionStatus {
  pending
  ok
  error

  @@map("erp_connection_status")
}

/// Formato do header Authorization aceito pela instalação (doc 34 Q2 — sem resposta da SG).
/// O produto descobre na prática: tenta o JWT puro e, em 401, repete com prefixo Bearer.
enum ErpAuthHeaderMode {
  raw
  bearer

  @@map("erp_auth_header_mode")
}

/// Conexão com o ERP SG de um tenant (doc 05 §1 / doc 12 §1).
///
/// Uma por tenant no MVP. A senha vive cifrada (envelope AES-256-GCM) e **nunca** é reexibida:
/// a UI é write-only e o serviço só decifra no instante de pedir o token (doc 09 §2).
model ErpConnection {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid

  /// Validado contra SSRF: sem IP privado, loopback, link-local ou metadata (doc 09 §3 API7).
  baseUrl          String     @map("base_url") @db.VarChar(255)
  /// SG Cloud usa o prefixo /public na autorização (doc 02 §1).
  isSgCloud        Boolean    @default(false) @map("is_sg_cloud")
  authPathOverride String?    @map("auth_path_override") @db.VarChar(255)
  tlsMode          ErpTlsMode @default(https) @map("tls_mode")

  username         String            @db.VarChar(120)
  /// Envelope AES-256-GCM: [versão][iv][tag][ciphertext]. Nem o DBA lê.
  secretCiphertext Bytes             @map("secret_ciphertext")
  secretKeyVersion Int               @map("secret_key_version")
  authHeaderMode   ErpAuthHeaderMode @default(raw) @map("auth_header_mode")

  /// Self-rate-limit por tenant (doc 12 §3) — a API SG não documenta limite (doc 34 Q3).
  maxRps          Int     @default(4) @map("max_rps")
  /// Janela para cargas pesadas, no fuso do tenant (doc 12 §1).
  syncWindowStart String? @map("sync_window_start") @db.VarChar(5)
  syncWindowEnd   String? @map("sync_window_end") @db.VarChar(5)

  status             ErpConnectionStatus @default(pending)
  lastError          String?             @map("last_error") @db.VarChar(300)
  lastTokenExpiresAt DateTime?           @map("last_token_expires_at") @db.Timestamptz(6)
  lastHealthAt       DateTime?           @map("last_health_at") @db.Timestamptz(6)
  /// Resposta do GET /status (versão do ERP, CNPJ da filial base) — sem segredo.
  healthPayload      Json?               @map("health_payload") @db.JsonB
  /// Claim `routes` do último token: o que o contrato com a SG libera (doc 12 §2).
  routesGranted      String[]            @default([]) @map("routes_granted")
  routesCheckedAt    DateTime?           @map("routes_checked_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("app_erp_connections")
}

// ============================================================================
// Sincronização (doc 05 §2 / doc 14) — estado dos jobs, não dado do ERP.
//
// Daqui para baixo as tabelas de tenant **não** declaram FK contra app_tenants (doc 05 §4): os
// ids vêm do ERP e podem chegar fora de ordem, e a purga física do offboarding (E6-04) apaga por
// tenant_id explicitamente. O isolamento continua garantido pela RLS estrita das migrações.
// ============================================================================

/// Estado da marca d'água de um domínio (doc 14 §1).
enum SyncStatus {
  idle
  running
  error

  @@map("sync_status")
}

/// Desfecho de uma execução de job (doc 05 §2).
enum SyncRunStatus {
  running
  success
  error
  skipped

  @@map("sync_run_status")
}

/// Até onde cada domínio já foi sincronizado, por filial quando o recorte existe.
///
/// `filial_erp_id = 0` significa "domínio sem recorte por filial" (dimensões, produtos): o doc 05
/// descreve a PK com `coalesce(filial_erp_id, 0)`, e guardar o zero em vez de NULL evita índice
/// parcial e comparação com NULL em cada upsert.
model SyncWatermark {
  tenantId    String @map("tenant_id") @db.Uuid
  domain      String @db.VarChar(40)
  filialErpId Int    @default(0) @map("filial_erp_id")

  /// Fatos por data: o último dia fechado com sucesso.
  watermarkDate DateTime? @map("watermark_date") @db.Date
  /// Cadastros por alteração: o instante da última varredura bem-sucedida.
  watermarkTs   DateTime? @map("watermark_ts") @db.Timestamptz(6)
  /// Retomada de backfill e paginação longa (doc 14 §3).
  cursor        Json?     @db.JsonB

  status        SyncStatus @default(idle)
  lastSuccessAt DateTime?  @map("last_success_at") @db.Timestamptz(6)
  lastError     String?    @map("last_error") @db.VarChar(300)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([tenantId, domain, filialErpId])
  @@index([tenantId, status])
  @@map("sync_watermarks")
}

/// Histórico de execuções — alimenta o painel de sync-status (E5-12) e o diagnóstico do doc 21.
model SyncJobRun {
  id          BigInt @id @default(autoincrement())
  tenantId    String @map("tenant_id") @db.Uuid
  domain      String @db.VarChar(40)
  filialErpId Int?   @map("filial_erp_id")
  /// Origem: cadência automática, backfill ou pedido manual do admin.
  trigger     String @default("scheduler") @db.VarChar(20)

  startedAt  DateTime      @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime?     @map("finished_at") @db.Timestamptz(6)
  status     SyncRunStatus @default(running)
  pages      Int           @default(0)
  items      Int           @default(0)
  apiCalls   Int           @default(0) @map("api_calls")
  /// Itens recusados pelo schema e mandados para quarentena (doc 12 §4.7).
  invalid    Int           @default(0)
  durationMs Int?          @map("duration_ms")
  error      String?       @db.VarChar(300)

  @@index([tenantId, domain, startedAt])
  @@index([tenantId, status])
  @@map("sync_job_runs")
}

/// Contabilidade de chamadas à API SG — **sem payload** (doc 05 §2); retenção de 30 dias.
model SyncApiCallLog {
  id         BigInt   @id @default(autoincrement())
  tenantId   String   @map("tenant_id") @db.Uuid
  endpoint   String   @db.VarChar(120)
  method     String   @db.VarChar(10)
  httpStatus Int      @map("http_status")
  durationMs Int      @map("duration_ms")
  items      Int      @default(0)
  calledAt   DateTime @default(now()) @map("called_at") @db.Timestamptz(6)

  @@index([tenantId, calledAt])
  @@map("sync_api_call_log")
}

// ============================================================================
// Espelho do ERP — dimensões (doc 05 §3)
//
// Todas compartilham o formato id+descrição da API. `erp_id` é texto porque o ERP mistura ids
// numéricos (marcas, departamentos) com códigos (unidades de medida: "UN", "KG").
// ============================================================================

/// Nível 1 da departamentalização — o corte que o dashboard usa por padrão (doc 15 §4).
model ErpDepartamentoN1 {
  tenantId             String   @map("tenant_id") @db.Uuid
  erpId                String   @map("erp_id") @db.VarChar(20)
  descricao            String   @db.VarChar(160)
  /// Encadeamento para o nível seguinte, quando a instalação usa a hierarquia completa.
  parentNextLevelErpId String?  @map("parent_next_level_erp_id") @db.VarChar(20)
  syncedAt             DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)

  @@id([tenantId, erpId])
  @@index([tenantId, syncedAt])
  @@map("erp_departamentos_n1")
}

model ErpDepartamentoN2 {
  tenantId             String   @map("tenant_id") @db.Uuid
  erpId                String   @map("erp_id") @db.VarChar(20)
  descricao            String   @db.VarChar(160)
  parentNextLevelErpId String?  @map("parent_next_level_erp_id") @db.VarChar(20)
  syncedAt             DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)

  @@id([tenantId, erpId])
  @@index([tenantId, syncedAt])
  @@map("erp_departamentos_n2")
}

