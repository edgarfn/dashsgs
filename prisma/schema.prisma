// ============================================================================
// Alertas (doc 05 §1 / doc 15 §8) — o que faz o produto ligar para o cliente.
// ============================================================================

/// Tipos de regra do doc 15 §8. Os que dependem de sync ainda não implementado existem no enum
/// de propósito: a tela mostra a regra desabilitada com o motivo, em vez de fingir que não existe.
enum AlertType {
  ruptura_curva_a
  estoque_negativo
  divergencia_fechamento
  queda_de_venda
  integracao_parada
  vencimento_proximo
  perda_anormal
  meta_em_risco
  conta_a_vencer
  cartao_nao_conciliado

  @@map("alert_type")
}

enum AlertSeverity {
  critica
  alta
  media
  baixa

  @@map("alert_severity")
}

enum AlertEventStatus {
  open
  acknowledged
  resolved

  @@map("alert_event_status")
}

enum NotificationStatus {
  pending
  sent
  failed

  @@map("notification_status")
}

/// Regra configurada por tenant. `params` guarda os limiares (doc 15 §8 "condição default").
model AlertRule {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name       String        @db.VarChar(120)
  type       AlertType
  severity   AlertSeverity
  /// Limiares ajustáveis; o formato é do tipo da regra (dias, percentual, hora-limite…).
  params     Json          @default("{}") @db.JsonB
  /// Canais ligados: o feed é sempre; o e-mail é opcional por regra (doc 15 §8).
  canalEmail Boolean       @default(true) @map("canal_email")
  /// Quem recebe: operação da loja ou administração do tenant.
  audiencia  String        @default("operacao") @db.VarChar(20)
  enabled    Boolean       @default(true)

  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  eventos AlertEvent[]

  @@unique([tenantId, type])
  @@index([tenantId, enabled])
  @@map("app_alert_rules")
}

/// Ocorrência de uma regra. A chave de dedupe é o que impede o mesmo problema de virar
/// cinquenta e-mails no mesmo dia (doc 15 §8: "dedupe diário por chave").
model AlertEvent {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  ruleId   String @map("rule_id") @db.Uuid

  filialErpId Int?             @map("filial_erp_id")
  dedupeKey   String           @map("dedupe_key") @db.VarChar(180)
  /// Contexto do evento: contagens, valores, ids envolvidos. Sem PII (doc 10 §1).
  payload     Json             @db.JsonB
  severity    AlertSeverity
  status      AlertEventStatus @default(open)

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  ackedBy    String?   @map("acked_by") @db.Uuid
  ackedAt    DateTime? @map("acked_at") @db.Timestamptz(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)

  rule AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, ruleId, dedupeKey])
  @@index([tenantId, status, createdAt])
  @@map("app_alert_events")
}

/// Entrega de uma notificação. Existe para responder "o alerta saiu?" sem depender do log do SMTP.
model Notification {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  userId       String             @map("user_id") @db.Uuid
  alertEventId String?            @map("alert_event_id") @db.Uuid
  channel      String             @default("email") @db.VarChar(20)
  status       NotificationStatus @default(pending)
  sentAt       DateTime?          @map("sent_at") @db.Timestamptz(6)
  error        String?            @db.VarChar(300)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, status])
  @@index([tenantId, alertEventId])
  @@map("app_notifications")
}

// ============================================================================
// Espelho do ERP — financeiro (doc 05 §3)
//
// Título e parcela são tabelas separadas porque é assim que o ERP entrega e é assim que o
// aging pergunta: o vencimento mora na parcela, não no título.
// ============================================================================

model ErpContaPagar {
  tenantId String @map("tenant_id") @db.Uuid
  erpId    Int    @map("erp_id")

  filialErpId     Int?      @map("filial_erp_id")
  fornecedorErpId Int?      @map("fornecedor_erp_id")
  documento       String?   @db.VarChar(40)
  dataEmissao     DateTime? @map("data_emissao") @db.Date
  valorTotal      Decimal?  @map("valor_total") @db.Decimal(14, 4)
  observacao      String?   @db.VarChar(300)
  syncedAt        DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)

  parcelas ErpContaPagarParcela[]

  @@id([tenantId, erpId])
  @@index([tenantId, dataEmissao])
  @@map("erp_contas_pagar")
}

/// Parcela: a unidade do fluxo de caixa. `status` vem do ERP (paga / não paga).
model ErpContaPagarParcela {
  tenantId   String @map("tenant_id") @db.Uuid
  contaErpId Int    @map("conta_erp_id")
  ordem      Int

  dataVencimento DateTime? @map("data_vencimento") @db.Date
  dataPagamento  DateTime? @map("data_pagamento") @db.Date
  valorDocumento Decimal?  @map("valor_documento") @db.Decimal(14, 4)
  valorPago      Decimal?  @map("valor_pago") @db.Decimal(14, 4)
  saldo          Decimal?  @db.Decimal(14, 4)
  paga           Boolean   @default(false)
  tipoLancamento String?   @map("tipo_lancamento") @db.VarChar(40)
  syncedAt       DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)

  conta ErpContaPagar @relation(fields: [tenantId, contaErpId], references: [tenantId, erpId], onDelete: Cascade)

  @@id([tenantId, contaErpId, ordem])
  @@index([tenantId, paga, dataVencimento])
  @@map("erp_conta_pagar_parcelas")
}

model ErpContaReceber {
  tenantId String @map("tenant_id") @db.Uuid
  erpId    Int    @map("erp_id")

  filialErpId  Int?      @map("filial_erp_id")
  clienteErpId Int?      @map("cliente_erp_id")
  documento    String?   @db.VarChar(40)
  dataEmissao  DateTime? @map("data_emissao") @db.Date
  valorTotal   Decimal?  @map("valor_total") @db.Decimal(14, 4)
  syncedAt     DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)

  parcelas ErpContaReceberParcela[]

  @@id([tenantId, erpId])
  @@index([tenantId, dataEmissao])
  @@map("erp_contas_receber")
}

model ErpContaReceberParcela {
  tenantId   String @map("tenant_id") @db.Uuid
  contaErpId Int    @map("conta_erp_id")
  ordem      Int

  dataVencimento DateTime? @map("data_vencimento") @db.Date
  dataPagamento  DateTime? @map("data_pagamento") @db.Date
  valorDocumento Decimal?  @map("valor_documento") @db.Decimal(14, 4)
  valorPago      Decimal?  @map("valor_pago") @db.Decimal(14, 4)
  saldo          Decimal?  @db.Decimal(14, 4)
  juros          Decimal?  @db.Decimal(14, 4)
  desconto       Decimal?  @db.Decimal(14, 4)
  paga           Boolean   @default(false)
  syncedAt       DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)

  conta ErpContaReceber @relation(fields: [tenantId, contaErpId], references: [tenantId, erpId], onDelete: Cascade)

  @@id([tenantId, contaErpId, ordem])
  @@index([tenantId, paga, dataVencimento])
  @@map("erp_conta_receber_parcelas")
}

/// Tipos de despesa: é o corte que separa custo fixo de variável no painel (doc 15 §5).
model ErpTipoDespesa {
  tenantId String @map("tenant_id") @db.Uuid
  erpId    String @map("erp_id") @db.VarChar(20)

  descricao     String  @db.VarChar(160)
  classificacao String? @db.VarChar(40)
  tipoCusto     String? @map("tipo_custo") @db.VarChar(40)
  dep1ErpId     String? @map("dep1_erp_id") @db.VarChar(20)

  syncedAt DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)

  @@id([tenantId, erpId])
  @@map("erp_tipos_despesa")
}

model ErpDespesa {
  tenantId    String   @map("tenant_id") @db.Uuid
  filialErpId Int      @map("filial_erp_id")
  dataDespesa DateTime @map("data_despesa") @db.Date
  sequencia   Int

  tipoDespesaErpId String?   @map("tipo_despesa_erp_id") @db.VarChar(20)
  fornecedorErpId  Int?      @map("fornecedor_erp_id")
  dataEmissao      DateTime? @map("data_emissao") @db.Date
  valor            Decimal   @db.Decimal(14, 4)
  classificacao    String?   @db.VarChar(40)
  /// Usuário do ERP que lançou — é dado de colaborador (doc 02 §PERSONAL_DATA), fica sem uso na UI.
  usuarioErp       String?   @map("usuario_erp") @db.VarChar(60)
  observacao       String?   @db.VarChar(300)
  syncedAt         DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)

  @@id([tenantId, filialErpId, dataDespesa, sequencia])
  @@index([tenantId, dataDespesa])
  @@index([tenantId, tipoDespesaErpId])
  @@map("erp_despesas")
}

/// Transações de cartão: uma linha por NSU. A chave natural é a `chaveVenda` do ERP.
model ErpCartaoVenda {
  tenantId   String @map("tenant_id") @db.Uuid
  chaveVenda String @map("chave_venda") @db.VarChar(60)

  filialErpId    Int       @map("filial_erp_id")
  nsu            String?   @db.VarChar(40)
  dataVenda      DateTime? @map("data_venda") @db.Date
  dataVencimento DateTime? @map("data_vencimento") @db.Date
  valorBruto     Decimal   @map("valor_bruto") @db.Decimal(14, 4)
  taxaPct        Decimal?  @map("taxa_pct") @db.Decimal(7, 4)
  tipoVenda      String?   @map("tipo_venda") @db.VarChar(40)
  formaPagamento String?   @map("forma_pagamento") @db.VarChar(40)
  bandeira       String?   @db.VarChar(60)
  adquirente     String?   @db.VarChar(60)
  parcela        Int?
  /// Baixada = conciliada no ERP. O que fica em aberto por dias vira alerta (doc 15 §8).
  baixada        Boolean   @default(false)
  syncedAt       DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)

  @@id([tenantId, chaveVenda])
  @@index([tenantId, dataVenda])
  @@index([tenantId, baixada, dataVenda])
  @@map("erp_cartao_vendas")
}

// ============================================================================
// Espelho do ERP — compras (doc 05 §3)
// ============================================================================

model ErpPedidoCompra {
  tenantId String @map("tenant_id") @db.Uuid
  erpId    Int    @map("erp_id")

  filialErpId     Int?      @map("filial_erp_id")
  fornecedorErpId Int?      @map("fornecedor_erp_id")
  compradorErpId  Int?      @map("comprador_erp_id")
  dataPedido      DateTime? @map("data_pedido") @db.Date
  dataPrevisao    DateTime? @map("data_previsao") @db.Date
  dataAtendimento DateTime? @map("data_atendimento") @db.Date
  /// atendido · pendente · parcial · semAceite · geradoNovoPedido (doc 03).
  situacao        String?   @db.VarChar(30)
  valorTotal      Decimal?  @map("valor_total") @db.Decimal(14, 4)
  valorFrete      Decimal?  @map("valor_frete") @db.Decimal(14, 4)
  syncedAt        DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)

  @@id([tenantId, erpId])
  @@index([tenantId, situacao, dataPedido])
  @@index([tenantId, dataPedido])
  @@map("erp_pedidos_compra")
}

model ErpNotaEntrada {
  tenantId String @map("tenant_id") @db.Uuid
  erpId    Int    @map("erp_id")

  filialErpId     Int?      @map("filial_erp_id")
  fornecedorErpId Int?      @map("fornecedor_erp_id")
  numero          String?   @db.VarChar(20)
  serie           String?   @db.VarChar(10)
  dataEmissao     DateTime? @map("data_emissao") @db.Date
  dataEntrada     DateTime? @map("data_entrada") @db.Date
  valorTotal      Decimal?  @map("valor_total") @db.Decimal(14, 4)
  situacao        String?   @db.VarChar(30)
  syncedAt        DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)

  @@id([tenantId, erpId])
  @@index([tenantId, dataEntrada])
  @@map("erp_notas_entrada")
}
