  custoMedio         Decimal? @map("custo_medio") @db.Decimal(14, 4)
  custoFiscalMedio   Decimal? @map("custo_fiscal_medio") @db.Decimal(14, 4)
  aliqMediaIcms      Decimal? @map("aliq_media_icms") @db.Decimal(7, 4)
  aliqMediaPisCofins Decimal? @map("aliq_media_pis_cofins") @db.Decimal(7, 4)

  qtdClientes          Int?     @map("qtd_clientes")
  qtdUnidades          Decimal? @map("qtd_unidades") @db.Decimal(14, 4)
  prodComVenda         Int?     @map("prod_com_venda")
  prodEstoqueAbaixoMin Int?     @map("prod_estoque_abaixo_min")
  prodEstoqueNegativo  Int?     @map("prod_estoque_negativo")
