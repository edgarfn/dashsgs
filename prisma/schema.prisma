  @@id([tenantId, filialErpId, data, caixa, cupom, ordem])
  @@index([tenantId, data, especie])
  @@map("erp_finalizadora_lancamentos")
}

/// Resumo diário por filial — a fonte das flags de fechamento que orquestram a consolidação.
model ErpFilialVendaResumo {
