model ErpUnidadeMedida {
  tenantId  String   @map("tenant_id") @db.Uuid
  erpId     String   @map("erp_id") @db.VarChar(20)
  descricao String   @db.VarChar(160)
  syncedAt  DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)

  @@id([tenantId, erpId])
  @@index([tenantId, syncedAt])
  @@map("erp_unidades_medida")
}

// ============================================================================
// Espelho do ERP — produtos e satélites (doc 05 §3)
// ============================================================================

/// Cadastro de produto **por filial**: custo, preço e estoque variam entre lojas da mesma rede,
/// e a API devolve uma linha por (produto, filial) — daí a chave natural de três partes.
model ErpProduto {
  tenantId    String @map("tenant_id") @db.Uuid
  filialErpId Int    @map("filial_erp_id")
  erpId       Int    @map("erp_id")

  descricao     String  @db.VarChar(160)
  dep1ErpId     String? @map("dep1_erp_id") @db.VarChar(20)
  marcaErpId    String? @map("marca_erp_id") @db.VarChar(20)
  classeErpId   String? @map("classe_erp_id") @db.VarChar(20)
  agrupErpId    String? @map("agrup_erp_id") @db.VarChar(20)
  unidadeMedida String? @map("unidade_medida") @db.VarChar(10)
  ativo         Boolean @default(true)
  balanca       Boolean @default(false)
  curvaAbc      String? @map("curva_abc") @db.VarChar(3)

  custoReal        Decimal? @map("custo_real") @db.Decimal(14, 4)
  custoFiscal      Decimal? @map("custo_fiscal") @db.Decimal(14, 4)
  custoComEncargos Decimal? @map("custo_com_encargos") @db.Decimal(14, 4)
  custoMedio       Decimal? @map("custo_medio") @db.Decimal(14, 4)
  precoCusto       Decimal? @map("preco_custo") @db.Decimal(14, 4)
  precoVenda1      Decimal? @map("preco_venda1") @db.Decimal(14, 4)
  precoVenda2      Decimal? @map("preco_venda2") @db.Decimal(14, 4)

  estoqueAtual     Decimal? @map("estoque_atual") @db.Decimal(14, 4)
  estoqueMinimo    Decimal? @map("estoque_minimo") @db.Decimal(14, 4)
  estoqueMaximo    Decimal? @map("estoque_maximo") @db.Decimal(14, 4)
  estoqueTrocas    Decimal? @map("estoque_trocas") @db.Decimal(14, 4)
  vendaMediaDiaria Decimal? @map("venda_media_diaria") @db.Decimal(14, 4)

  dataCadastro    DateTime? @map("data_cadastro") @db.Date
  dataAltPreco    DateTime? @map("data_alt_preco") @db.Date
  dataAltCusto    DateTime? @map("data_alt_custo") @db.Date
  dataAltCadastro DateTime? @map("data_alt_cadastro") @db.Date
  syncedAt        DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)

  @@id([tenantId, filialErpId, erpId])
  @@index([tenantId, syncedAt])
  @@index([tenantId, dep1ErpId])
  @@index([tenantId, ativo, estoqueAtual])
  @@map("erp_produtos")
}

/// Códigos de barras. A chave é o GTIN: um produto tem vários, um GTIN pertence a um produto.
model ErpGtin {
  tenantId        String   @map("tenant_id") @db.Uuid
  gtin            String   @db.VarChar(20)
  produtoErpId    Int      @map("produto_erp_id")
  qtdPorEmbalagem Decimal? @map("qtd_por_embalagem") @db.Decimal(14, 4)
  syncedAt        DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)

  @@id([tenantId, gtin])
  @@index([tenantId, produtoErpId])
  @@map("erp_gtins")
}

// ============================================================================
// Espelho do ERP — fatos de venda (doc 05 §3)
//
// is_realtime distingue o dia corrente (provisório, de /vendas/hoje) do dia fechado (consolidado,
// de /vendas) — a UI mostra o selo correspondente (doc 14 §7).
// ============================================================================

model ErpVendaCupom {
  tenantId    String   @map("tenant_id") @db.Uuid
  filialErpId Int      @map("filial_erp_id")
  data        DateTime @db.Date
  caixa       Int
  cupom       Int

  serieNfc String? @map("serie_nfc") @db.VarChar(10)
  /// HH:MM no fuso da loja (doc 34 Q12 em aberto) — guardado como texto para não inventar fuso.
  horario  String? @db.VarChar(5)

  /// Só preenchido com o módulo Clientes habilitado (doc 10 §1); identificada sobrevive sem ele.
  clienteErpId  Int?    @map("cliente_erp_id")
  identificada  Boolean @default(false)
  vendedorErpId Int?    @map("vendedor_erp_id")

  cancelada  Boolean  @default(false)
  valorTotal Decimal  @map("valor_total") @db.Decimal(14, 4)
  isRealtime Boolean  @default(false) @map("is_realtime")
  syncedAt   DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)

  @@id([tenantId, filialErpId, data, caixa, cupom])
  @@index([tenantId, data])
  @@index([tenantId, filialErpId, data, isRealtime])
  @@map("erp_vendas_cupons")
}

model ErpVendaItem {
  tenantId    String   @map("tenant_id") @db.Uuid
  filialErpId Int      @map("filial_erp_id")
  data        DateTime @db.Date
  caixa       Int
  cupom       Int
  ordem       Int

  produtoErpId     Int?    @map("produto_erp_id")
  gtin             String? @db.VarChar(20)
  quantidade       Decimal @db.Decimal(14, 4)
  precoVenda       Decimal @map("preco_venda") @db.Decimal(14, 4)
  desconto         Decimal @default(0) @db.Decimal(14, 4)
  acrescimo        Decimal @default(0) @db.Decimal(14, 4)
  cancelado        Boolean @default(false)
  ofertaErpId      String? @map("oferta_erp_id") @db.VarChar(20)
  pedidoVendaErpId Int?    @map("pedido_venda_erp_id")

  icmsBase       Decimal? @map("icms_base") @db.Decimal(14, 4)
  icmsAliq       Decimal? @map("icms_aliq") @db.Decimal(7, 4)
  icmsValor      Decimal? @map("icms_valor") @db.Decimal(14, 4)
  pisBase        Decimal? @map("pis_base") @db.Decimal(14, 4)
  cofinsBase     Decimal? @map("cofins_base") @db.Decimal(14, 4)
  tipoTributacao String?  @map("tipo_tributacao") @db.VarChar(10)
  modeloDoc      String?  @map("modelo_doc") @db.VarChar(10)

  isRealtime Boolean  @default(false) @map("is_realtime")
  syncedAt   DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)

  @@id([tenantId, filialErpId, data, caixa, cupom, ordem])
  @@index([tenantId, produtoErpId, data])
  @@index([tenantId, data])
  @@map("erp_venda_itens")
}

/// Lançamentos por forma de pagamento. A ordem é posicional dentro do cupom: a API não dá chave
/// própria, e o mesmo cupom pode ter dois lançamentos idênticos (duas notas de dinheiro).
model ErpFinalizadoraLancamento {
  tenantId    String   @map("tenant_id") @db.Uuid
