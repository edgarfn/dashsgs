{
  "uid": "dashsgs-plataforma",
  "title": "DashSGS · Visão da plataforma",
  "description": "Tráfego, erros, latência e sessões da API interna (doc 18 §7.1). É o painel que se abre primeiro: responde 'o produto está no ar e rápido?' antes de qualquer hipótese.",
  "tags": ["dashsgs"],
  "timezone": "America/Sao_Paulo",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["30s", "1m", "5m", "15m", "1h"]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Agora",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Requisições/s (leitura)",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "dashsgs-prometheus"
      },
      "description": "GET sob /api/v1 — o tráfego que o dashboard gera.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "expr": "dashsgs:leitura:requisicoes_rate5m",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dashsgs-prometheus"
          },
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Erro 5xx (5 min)",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "dashsgs-prometheus"
      },
      "description": "",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.005
              },
              {
                "color": "red",
                "value": 0.02
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "expr": "dashsgs:leitura:erro_ratio5m",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dashsgs-prometheus"
          },
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
