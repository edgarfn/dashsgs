# DashSGS — imagem da API/workers (doc 19 §2).
# Princípios do doc 09 §1 "Infraestrutura": base slim, usuário não-root, sem build toolchain no
# runtime, artefato imutável promovido entre ambientes.
# Contexto de build: raiz do repositório.

# ------------------------------------------------------------------ base
FROM node:22.14.0-alpine AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable && apk add --no-cache libc6-compat
WORKDIR /app

# ------------------------------------------------------------------ deps
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --ignore-scripts

# ------------------------------------------------------------------ build
FROM deps AS build
COPY tsconfig.base.json ./
COPY prisma ./prisma
COPY packages/shared ./packages/shared
COPY apps/api ./apps/api
# `pnpm deploy` monta em /out uma árvore autocontida só com dependências de produção; o client
# do Prisma é gerado DEPOIS, já dentro dessa árvore, para o engine casar com o node_modules final.
RUN pnpm --filter @dashsgs/shared build \
 && pnpm exec prisma generate \
 && pnpm --filter @dashsgs/api build \
 && pnpm deploy --filter=@dashsgs/api --prod --legacy /out \
 && cp -r prisma /out/prisma \
 && cd /out \
 && node node_modules/prisma/build/index.js generate --schema prisma/schema.prisma

# ------------------------------------------------------------------ runner
FROM base AS runner
ENV NODE_ENV=production
# `tini` garante encerramento gracioso (SIGTERM chega ao Node, não ao shell).
RUN apk add --no-cache tini && addgroup -g 10001 -S app && adduser -u 10001 -S app -G app
WORKDIR /app

COPY --from=build --chown=app:app /out/node_modules ./node_modules
COPY --from=build --chown=app:app /out/dist ./dist
COPY --from=build --chown=app:app /out/prisma ./prisma
COPY --chown=app:app package.json ./

USER app
EXPOSE 3001

# A versão do artefato é injetada pelo pipeline (doc 11 §1) e aparece em /healthz e nos logs.
ARG APP_VERSION=0.0.0-local
ENV APP_VERSION=$APP_VERSION

# Mesma imagem serve dois comandos (doc 19 §2): `api` (dist/main.js, escuta em PORT) e
# `workers` (dist/worker.js, escuta em WORKER_PORT — doc 04 §2). O healthcheck não sabe qual dos
# dois está rodando neste container, então tenta as duas portas e passa se qualquer uma responder
# — a que não tem processo do lado simplesmente recusa a conexão e cai no catch.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "\
    const testar = (porta) => fetch('http://127.0.0.1:' + porta + '/healthz').then((r) => r.ok).catch(() => false); \
    Promise.all([testar(process.env.PORT || 3001), testar(process.env.WORKER_PORT || 3002)]) \
      .then(([api, worker]) => process.exit(api || worker ? 0 : 1));"

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/main.js"]
